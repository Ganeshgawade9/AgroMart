# Copy this file to .env and fill in your values
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)

SECRET_KEY=django-insecure-change-this-in-production-use-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=*

# CORS - add your frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
# Leave empty to use SQLite (good for development)
# For PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Cloudinary - for product image storage
# Get free account at cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps API Key
# Enable: Maps JavaScript API, Places API, Directions API
# Get at console.cloud.google.com
GOOGLE_MAPS_API_KEY=

# Razorpay - Indian payment gateway
# Get test keys at dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cohere AI - for smart chatbot responses
# Free tier at cohere.com (1000 calls/month free)
# If empty, chatbot uses rule-based responses (still works!)
COHERE_API_KEY=

# OpenAI (optional alternative to Cohere)
OPENAI_API_KEY=


# SMS for OTPs (forgot password, order handover)
# console = just log OTPs to the server terminal (development)
# fast2sms / twilio = real SMS, fill in the matching keys
SMS_BACKEND=console
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
